{
    "name": "snapwp/snap-core",
    "license": "GPL-3.0-or-later",
    "description": "Core files for Snap",
    "authors": [
        {
            "name": "Jake Whiteley",
            "email": "jakebwhiteley@gmail.com"
        }
    ],
    "keywords": [
        "wordpress"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Snap\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Snap\\Tests\\": "tests/"
        }
    },
    "require": {
        "php": "^8.3",
        "jakewhiteley/hodl": "~1.6",
        "symfony/console": "^7.0",
        "doctrine/inflector": "^2.0",
        "illuminate/container": "^13.0",
        "illuminate/events": "^13.0",
        "illuminate/filesystem": "^13.0",
        "illuminate/support": "^13.0",
        "illuminate/view": "^13.0",
        "somnambulist/validation": "^1.9",
        "ramsey/uuid": "^4.7"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.13",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "wp-coding-standards/wpcs": "^3.1",
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpunit/phpunit": "^12.0"
    },
    "bin": [
        "bin/snap"
    ],
    "scripts": {
        "sniff": [
            "phpcs --extensions=php ."
        ],
        "fix": [
            "php-cs-fixer fix",
            "phpcbf --extensions=php ."
        ],
        "sniff-docs": [
            "phpcs --ignore=*/vendor/* --extensions=php --standard=WordPress-Docs --exclude=Squiz.Commenting.FileComment ."
        ],
        "fix-docs": [
            "phpcbf --ignore=*/vendor/* --extensions=php --standard=WordPress-Docs --exclude=Squiz.Commenting.FileComment ."
        ],
        "test": [
            "phpunit --coverage-text"
        ],
        "report": [
            "phpunit --coverage-html coverage"
        ]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        },
        "platform": {
            "php": "8.3.0"
        }
    }
}
