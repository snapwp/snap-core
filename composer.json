{
    "name": "snapwp/snap-core",
    "license": "GPL-3.0-or-later",
    "description": "Core files for Snap",
    "authors": [
        {
            "name": "Jake Whiteley",
            "email": "jakebwhiteley@gmail.com"
        }
    ],
    "keywords": [
        "wordpress"
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "Snap\\": "src/"
        },
        "files": [
            "src/functions.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Snap\\Tests\\": "test/"
        }
    },
    "require": {
        "php": ">=7.4",
        "jakewhiteley/hodl": "^1.5",
        "rakit/validation": "~1.0",
        "symfony/console": "^4.4|^5.4",
        "symfony/process": "^4.4|^5.4",
        "doctrine/inflector": "^1.3",
        "tightenco/collect": "^8.81",
        "jakewhiteley/bladezero": "~8.83.10 <8.83.27"
    },
    "require-dev": {
        "squizlabs/php_codesniffer": "^3.7",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "wp-coding-standards/wpcs": "^2.3",
        "friendsofphp/php-cs-fixer": "^3.0",
        "phpunit/phpunit": "^8.5.19|^9.5"
    },
    "bin": [
        "bin/snap"
    ],
    "scripts": {
        "sniff": [
            "phpcs --extensions=php ."
        ],
        "fix": [
            "php-cs-fixer fix",
            "phpcbf --extensions=php ."
        ],
        "sniff-docs": [
            "phpcs --ignore=*/vendor/* --extensions=php --standard=WordPress-Docs --exclude=Squiz.Commenting.FileComment ."
        ],
        "fix-docs": [
            "phpcbf --ignore=*/vendor/* --extensions=php --standard=WordPress-Docs --exclude=Squiz.Commenting.FileComment ."
        ],
        "test": [
            "phpunit --coverage-text"
        ],
        "report": [
            "phpunit --coverage-html coverage"
        ]
    }
}
